## ภูมิหลังพิเศษของจอมยุทธ์ที่เกิดมาพร้อมวิชาขั้นสูง
const WANDERER_STORIES = [
	"เคยเป็นจอมยุทธ์พเนจรผู้มีชื่อเสียงในยุทธภพ ก่อนจะเบื่อหน่ายการเข่นฆ่าและมาขอพักพิงที่สำนัก",
	"เป็นศิษย์คนสุดท้ายของสำนักใหญ่ที่ถูกล้างบาง พกวิชาลับของอาจารย์ติดตัวมาด้วย",
	"เคยฝึกวิชากับยอดฝีมือสันโดษบนยอดเขาถึงสิบปี",
]

static func roll_race(rng: RandomNumberGenerator = null) -> String:
	var total = 0
	for r in RACES: total += RACES[r].weight
	var roll = (rng.randi() if rng else randi()) % total
	for r in RACES:
		roll -= RACES[r].weight
		if roll < 0: return r
	return "มนุษย์"

static func generate_story(race: String, is_wanderer: bool = false) -> String:
	var origin: String = ORIGINS.get(race, ORIGINS["มนุษย์"]).pick_random()
	var story = "%s %s และ%s %s" % [origin, CHILDHOODS.pick_random(), EVENTS.pick_random(), MOTIVES.pick_random()]
	if is_wanderer:
		story += "\n\n" + WANDERER_STORIES.pick_random()
	return story
